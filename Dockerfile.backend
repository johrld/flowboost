FROM node:22-bookworm-slim

WORKDIR /app

# Git + Playwright browser dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    && npx playwright install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI (must match Agent SDK version)
RUN npm install -g @anthropic-ai/claude-code@latest

# Skip interactive onboarding
RUN echo '{"hasCompletedOnboarding":true}' > /root/.claude.json

COPY package*.json .npmrc ./
RUN npm ci --production=false

COPY . .
RUN npm run build

RUN npm prune --production

# Install Playwright browser
RUN npx playwright install chromium 2>/dev/null || true

ENV NODE_ENV=production
EXPOSE 6100
CMD ["node", "dist/index.js"]
